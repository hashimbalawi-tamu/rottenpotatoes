
<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>

<h1>Movies</h1>

<table>
  
  <thead>
    <tr>
      <th class="<%= @sort == 'title' ? "sorted-#{@direction}" : "" %>">
        <%= sort_link("title", "Title") %>
        <% if @sort == "title" %>
          <span aria-label="<%= @direction == 'asc' ? 'Sorted ascending' : 'Sorted descending' %>">
            <%= @direction == "asc" ? "↑" : "↓" %>
          </span>
        <% end %>
      </th>

      <th class="<%= @sort == 'rating' ? "sorted-#{@direction}" : "" %>">
        <%= sort_link("rating", "Rating") %>
        <% if @sort == "rating" %>
          <span aria-label="<%= @direction == 'asc' ? 'Sorted ascending' : 'Sorted descending' %>">
            <%= @direction == "asc" ? "↑" : "↓" %>
          </span>
        <% end %>
      </th>

      <th class="<%= @sort == 'release_date' ? "sorted-#{@direction}" : "" %>">
        <%= sort_link("release_date", "Release Date") %>
        <% if @sort == "release_date" %>
          <span aria-label="<%= @direction == 'asc' ? 'Sorted ascending' : 'Sorted descending' %>">
            <%= @direction == "asc" ? "↑" : "↓" %>
          </span>
        <% end %>
      </th>
    </tr>
  </thead>


  <tbody>
    <% @movies.each do |movie| %>
      <tr>
        <td><%= link_to movie.title, movie %></td>
        <td><%= movie.rating %></td>
        <td><%= movie.release_date&.strftime("%B %d, %Y") %></td>
      </tr>
    <% end %>
  </tbody>

  <tfoot>
    <tr>
      <td colspan="3">
        Total movies: <%= @movies.size %>
      </td>
    </tr>
  </tfoot>
</table>

<p><%= link_to "New movie", new_movie_path %></p>
